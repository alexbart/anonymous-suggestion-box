# Database (Neon / Postgres)
# Local dev: a local Postgres is fine (e.g. postgresql://USER:PASSWORD@localhost:5432/suggestion_box)
# Production / Vercel: use a Neon connection string with sslmode=require
# Example: postgresql://USER:PASSWORD@ep-xxx-pooler.us-east-1.aws.neon.tech/verceldb?sslmode=require&channel_binding=require
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/suggestion_box"

# API
API_PORT=3001
API_HOST=0.0.0.0
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=info
NODE_ENV=development

# Admin authentication
# Generate a strong random secret, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-this-password-min-12-chars
